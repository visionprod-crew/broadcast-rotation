rules_version = '2';
// SLS 방송팀 관리 시스템 — Firestore 보안 규칙
// ⚠️ OWNER 이메일은 config.js 의 ownerId@loginDomain 과 같아야 합니다. (기본: admin@vfc-rotation.app)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == 'admin@vfc-rotation.app'; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isViewer() { return isOwner() || (hasProfile() && role() in ['leader', 'subleader', 'member']); }
    function isStaff() { return isOwner() || (hasProfile() && role() in ['leader', 'subleader']); }
    function isLeader() { return isOwner() || (hasProfile() && role() == 'leader'); }

    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }
    match /rotations/{date} { allow read: if isViewer(); allow write: if isStaff(); }   // 팀원은 보기만
    match /members/{id}     { allow read: if isViewer(); allow write: if isLeader(); }
    match /settings/{id}    { allow read: if isViewer(); allow write: if isOwner(); }
    match /pushSubs/{id} {                                                              // 폰 알림 구독 (기기별)
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isViewer() && request.resource.data.uid == request.auth.uid;
      allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /secrets/{id} { allow read: if isStaff(); allow write: if isOwner(); }       // 푸시 서명 키
    match /acks/{id} {                                                                  // 포지션 알림 '확인했어요'
      allow read: if isViewer();
      allow create, update: if isViewer() && request.resource.data.uid == request.auth.uid;
      allow delete: if isStaff();
    }
  }
}
